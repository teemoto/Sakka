# Copy this file to .env.local for the first configured application run.
# These repository settings are intentionally non-secret. Never commit .env.local.

SAKKA_GITHUB_OWNER=teemoto
SAKKA_GITHUB_REPOSITORY=aslambhai
SAKKA_GITHUB_BASE_BRANCH=sakka/dogfood
SAKKA_CONTENT_DIRECTORY=src/content/articles
SAKKA_CONTENT_EXTENSIONS=.md,.mdx
SAKKA_FRONTMATTER_FIELDS=title,description,publishedAt,minutes,topic,icon,draft,featured

# Authentication and persistence are not implemented yet. Add these only when
# their corresponding server-side work begins.
# SAKKA_GITHUB_APP_ID=
# SAKKA_GITHUB_CLIENT_ID=
# SAKKA_GITHUB_CLIENT_SECRET=
# SAKKA_GITHUB_PRIVATE_KEY=
# DATABASE_URL=
# SAKKA_SESSION_SECRET=
